POSTGRES_USER=beautyboss
POSTGRES_PASSWORD=***
POSTGRES_DB=beautyboss

DATABASE_URL=postgresql+asyncpg://beautyboss:change-me@localhost:5432/beautyboss

LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=***
LLM_MODEL=your-model-name
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_MAX_RETRIES=3

# سایت / Spring Boot (API واقعی beautyboss.ir)
SPRING_BOOT_BASE_URL=https://api.beautyboss.ir
SPRING_BOOT_TIMEOUT=10
BEAUTYBOSS_SITE_URL=https://beautyboss.ir

# Chat / فاز ۲
CHAT_HISTORY_LIMIT=8
CHAT_MAX_MESSAGE_CHARS=2000
CONVERSATIONS_PAGE_SIZE=20
CONVERSATIONS_MAX_PAGE_SIZE=50
GUEST_COOKIE_NAME=bb_guest_session
GUEST_SESSION_HEADER=X-Guest-Session-Id
ENABLE_LISTING_TOOLS=true
ENABLE_KNOWLEDGE_TOOLS=true

# JWT صادرشده توسط سایت اصلی — سرویس فقط اعتبارسنجی می‌کند
# ۱) Keycloak/Spring: آدرس JWKS (اولویت دارد)
JWT_JWKS_URL=
# ۲) RS256 با کلید عمومی ثابت \\n برای خط جدید
JWT_PUBLIC_KEY=
# ۳) HS256 با کلید مشترک
JWT_ALGORITHM=HS256
JWT_SECRET=
JWT_USER_ID_CLAIM=sub
JWT_ROLE_CLAIM=
JWT_ISSUER=
JWT_AUDIENCE=

# محدودیت‌ها (فاز ۴)
ANONYMOUS_RATE_PER_MINUTE=10
ANONYMOUS_RATE_PER_DAY=30
USER_RATE_PER_MINUTE=20
USER_RATE_PER_DAY=200
DAILY_TOKEN_LIMIT=2000000
# فقط وقتی پشت reverse proxy مورد اعتماد هستی true کن (وگرنه X-Forwarded-For جعل‌پذیر است)
TRUST_PROXY_HEADERS=false

# CORS — پیش‌فرض بسته است؛ دامنه فرانت را با کاما اضافه کن
CORS_ORIGINS=http://localhost:4200

# پیشوند مسیر API (اگر سایت اصلی سرویس را زیر مسیر دیگری mount می‌کند)
API_PREFIX=/api/v1
